# 后端生产环境示例（deploy.sh 会自动生成/覆盖这些值，无需手改）
# 复制为 backend/.env 后可手动调整

# JWT 签名密钥（生产环境请务必改为随机长字符串；deploy.sh 首次会自动生成）
SECRET_KEY=your-secret-key-here-change-in-production

# 调试模式（生产务必 False）
DEBUG=False

# 监听地址与端口（0.0.0.0 表示对外）
HOST=0.0.0.0
PORT=8080

# 是否由 FastAPI 直接托管前端 dist/（生产 True，前后端同源一个端口）
SERVE_FRONTEND=True

# CORS 允许的源（逗号分隔；生产建议填你的域名/IP，留空则由代码按局域网正则放行）
CORS_ORIGINS=
